# Clay backend (Phase 1.1). Copy to .env and fill in.
# The server-held model key — users never need their own (ADR-011).
ANTHROPIC_API_KEY=sk-ant-...
# Port the proxy listens on (default 8787).
PORT=8787
# Explicit local development mode. Production requires Postgres + Resend and
# never returns magic links in an API response.
AUTH=dev
# Production:
# DATABASE_URL=postgres://user:password@host/db
# RESEND_API_KEY=re_...
# FROM_EMAIL=Clay <login@yourdomain.com>
# APP_ORIGIN=https://yourdomain.com
